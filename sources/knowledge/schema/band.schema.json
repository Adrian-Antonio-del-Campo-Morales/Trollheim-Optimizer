{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "band.schema.json",
  "title": "Banda canónica de Trollheim",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "source", "roster", "equipment_lists", "profiles"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "source": {"$ref": "source.schema.json"},
    "roster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_models", "maximum_models", "starting_gold", "members"],
      "properties": {
        "minimum_models": {"type": "integer", "minimum": 1},
        "maximum_models": {"type": "integer", "minimum": 1},
        "starting_gold": {"type": "integer", "minimum": 0},
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile_id", "minimum", "maximum"],
            "properties": {
              "profile_id": {"type": "string"},
              "minimum": {"type": "integer", "minimum": 0},
              "maximum": {"type": ["integer", "null"], "minimum": 0}
            }
          }
        }
      }
    },
    "equipment_lists": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "items", "source"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item_id", "cost"],
              "properties": {
                "item_id": {"type": "string"},
                "cost": {
                  "oneOf": [
                    {"type": "integer", "minimum": 0},
                    {"type": "string", "minLength": 1}
                  ]
                },
                "notes": {"type": "string"}
              }
            }
          },
          "source": {"$ref": "source.schema.json"}
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "profile.schema.json"}
    },
    "band_rules": {
      "type": "array",
      "items": {"$ref": "rule.schema.json"}
    }
  }
}
